# Copier ce fichier en .env, puis remplir. NE JAMAIS publier le .env.
# Les lignes vides = valeur à fournir. Les autres = valeur par défaut.

# --- Application ---
APP_NAME=AI-Kube
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=
K8S_NAMESPACE=default
KUBECONFIG=~/.kube/config

# --- Modèles distants (au moins une clé) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=

# --- KubeLLM local (Ollama) ---
OLLAMA_URL=http://localhost:11434
KUBELLM_MODEL=kubellm-v2
KUBELLM_BASE_MODEL=qwen2.5-coder:1.5b
KUBELLM_V3_MODEL=kubellm-v3
KUBELLM_V4_MODEL=kubellm-v4

# Ancien modèle v1 (phi-2), hors service
BASE_MODEL=microsoft/phi-2
FINE_TUNED_MODEL_PATH=./models/fine_tuned/kubellm-v1
USE_FINE_TUNED=false

# --- Agent : limites d'exécution ---
AIKUBE_EXEC_READONLY=
AIKUBE_EXEC_TIMEOUT=
AIKUBE_EXEC_MAX_OUTPUT=

# --- Mobile et notifications ---
MOBILE_TOKEN=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Divers ---
PROMETHEUS_URL=http://localhost:9090
GITHUB_REPO=
GITHUB_TOKEN=
