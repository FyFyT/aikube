/v1, StatefulSet=apps/v1, DaemonSet=apps/v1, ReplicaSet=apps/v1, Job=batch/v1, CronJob=batch/v1, Pod=v1, Service=v1, ConfigMap=v1, Secret=v1, PersistentVolumeClaim=v1, PersistentVolume=v1, Namespace=v1, ServiceAccount=v1, Ingress=networking.k8s.io/v1, IngressClass=networking.k8s.io/v1, NetworkPolicy=networking.k8s.io/v1, HorizontalPodAutoscaler=autoscaling/v2, PodDisruptionBudget=policy/v1, Role=rbac.authorization.k8s.io/v1, RoleBinding=rbac.authorization.k8s.io/v1, ClusterRole=rbac.authorization.k8s.io/v1, ClusterRoleBinding=rbac.authorization.k8s.io/v1, StorageClass=storage.k8s.io/v1, LimitRange=v1, ResourceQuota=v1, PriorityClass=scheduling.k8s.io/v1\nAutres kinds disponibles : APIService, Binding, CSIDriver, CSINode, CSIStorageCapacity, CertificateSigningRequest, ComponentStatus, ControllerRevision, CustomResourceDefinition, EndpointSlice, Endpoints, Event, FlowSchema, Lease, LocalSubjectAccessReview, MutatingWebhookConfiguration, Node, NodeMetrics, PodMetrics, PodTemplate, PriorityLevelConfiguration, ReplicationController, RuntimeClass, SelfSubjectAccessReview, SelfSubjectReview, SelfSubjectRulesReview, SubjectAccessReview, TokenReview, ValidatingWebhookConfiguration, VolumeAttachment\n\n## Demande de l'utilisateur\nMettre en ligne memcached avec un Service NodePort"}, {"role": "assistant", "content": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: memcached-deployment\n  namespace: default\n  labels:\n    app: memcached\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: memcached\n  template:\n    metadata:\n      labels:\n        app: memcached\n    spec:\n      containers:\n      - name: memcached\n        image: memcached:1.6.17\n        ports:\n        - containerPort: 11211\n        resources:\n          requests:\n            cpu: \"250m\"\n            memory: \"256Mi\"\n          limits:\n            cpu: \"500m\"\n            memory: \"512Mi\"\n        securityContext:\n          allowPrivilegeEscalation: false\n        readinessProbe:\n          tcpSocket:\n            port: 11211\n          initialDelaySeconds: 5\n          periodSeconds: 10\n        livenessProbe:\n          tcpSocket:\n            port: 11211\n          initialDelaySeconds: 15\n          periodSeconds: 20\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: memcached-service\n  namespace: default\n  labels:\n    app: memcached\nspec:\n  type: NodePort\n  selector:\n    app: memcached\n  ports:\n  - port: 11211\n    targetPort: 11211\n    nodePort: 31234\n    protocol: TCP\n"}], "meta": {"category": "workload", "profile": "p0079-kind", "teacher_rank": 1, "teacher": "openai/gpt-oss-120b"}}
