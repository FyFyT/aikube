   tcpSocket:\n            port: 8000\n          initialDelaySeconds: 5\n          periodSeconds: 10\n        livenessProbe:\n          tcpSocket:\n            port: 8000\n          initialDelaySeconds: 15\n          periodSeconds: 20\n        securityContext:\n          allowPrivilegeEscalation: false\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: api\n  namespace: monitoring\n  labels:\n    app: api\nspec:\n  selector:\n    app: api\n  ports:\n  - protocol: TCP\n    port: 8000\n    targetPort: 8000\n"}], "meta": {"category": "workload", "profile": "p0059-minikube", "teacher_rank": 1, "teacher": "openai/gpt-oss-120b"}}
